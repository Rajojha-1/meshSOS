<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#090D16">

    <!-- Top Status Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="MeshSOS"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_server_settings"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="⚙ Server"
            android:textColor="#94A3B8"
            android:backgroundTint="#1E293B"
            android:textSize="11sp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tv_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MESH ACTIVE"
            android:textColor="#10B981"
            android:background="#1510B981"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Emergency SOS Big Button -->
    <Button
        android:id="@+id/btn_sos"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:text="🚨 SEND SOS"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:backgroundTint="#DC2626"
        android:layout_marginBottom="16dp" />

    <!-- "I'm OK now" Button (Visible only after SOS is triggered) -->
    <Button
        android:id="@+id/btn_ok_now"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="✅ I'M OK NOW (Cancel SOS)"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#059669"
        android:visibility="gone"
        android:layout_marginBottom="20dp" />

    <!-- Peer Mesh Info Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#111827"
        android:padding="16dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Peer Network Status"
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_peers_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 Peers in Direct Range"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_last_seen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Broadcasting periodic heartbeat beacon"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Stop Sharing Button -->
    <Button
        android:id="@+id/btn_stop_sharing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Stop Sharing (Opt-Out)"
        android:textColor="#94A3B8"
        android:backgroundTint="#1F2937"
        android:layout_marginTop="auto" />
</LinearLayout>

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MeshSOS Protocol Specification",
  "version": "1.0.0",
  "message_types": {
    "HEARTBEAT": 1,
    "SOS": 2,
    "OK_NOW": 3,
    "LOWBAT": 4,
    "ACK": 5
  },
  "lowbat_reasons": {
